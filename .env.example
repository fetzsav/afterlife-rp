# Copy to .env and fill in real values. Never commit .env (rule 12).
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=afterlife
MARIADB_USER=afterlife
MARIADB_PASSWORD=change-me
# Bind address for the MariaDB port. Use 127.0.0.1 for host-only development.
# The Pterodactyl game container reaches the DB via the docker bridge gateway,
# so production binds to the bridge IP instead (see docs/admin-setup.md).
MARIADB_BIND=127.0.0.1
MARIADB_PORT=3306
